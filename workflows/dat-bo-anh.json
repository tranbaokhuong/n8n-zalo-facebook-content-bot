      "parameters": {
        "jsCode": "// /datanh <số>: thay CẢ BỘ ảnh của bài bằng các ảnh vừa gửi (tối đa 10, dùng chung Fanpage + Zalo)\nconst cmd = $('Khi được gọi').first().json;\nconst id = String(cmd.id);\nconst row = $('Đọc lịch đăng').all().map(i => i.json).find(r => String(r['ID']) === id);\nconst bad = (reply) => [{ json: { ok: false, reply } }];\nif (!row) return bad(`❌ Không tìm thấy bài #${id} trong lịch đăng.`);\nconst st = String(row['Trạng thái'] || '').trim();\nif (st !== 'Chờ duyệt') return bad(`ℹ️ Bài #${id} đang \"${st || 'trống'}\". /datanh chỉ dùng cho bài Chờ duyệt (đổi cả ảnh chính).`);\nconst urls = (cmd.urls || []).filter(Boolean);\nif (!urls.length) return bad(`ℹ️ Chưa thấy ảnh nào cho bài #${id}.\\n📎 Gửi CẢ BỘ ảnh vào nhóm (1 lần hoặc nhiều lần), rồi gõ /datanh ${id} trong vòng 15 phút.\\n(Hoặc gửi ảnh kèm ghi chú /datanh ${id})`);\nconst ds = urls.slice(0, 10);\nconst k = { ok: true, id, boQua: Math.max(0, urls.length - 10), curAnh: String(row['Link ảnh'] || '').trim(), curBia: String(row['Ảnh bìa OA'] || '').trim(),\n  curZalo: String(row['Ảnh Zalo'] || '').trim(), curThem: String(row['Ảnh thêm'] || '').trim(), note0: String(row['Ghi chú'] || '').trim() };\nreturn ds.map((url, i) => ({ json: { ...k, url, i } }));"
      },
