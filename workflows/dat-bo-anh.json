        "jsCode": "// Bỏ ảnh gửi lặp trong bộ (giữ lần đầu)\nconst ks = $('Kiểm tra lệnh').all().map(i => i.json);\nlet tr = []; try { tr = $input.first().json.trung || []; } catch (e) {}\nconst bo = new Map(tr.map(t => [t.moi, t]));\nconst trungMsg = bo.size ? `\\n♻️ Bỏ ${bo.size} ảnh gửi lặp (${[...bo.entries()].map(([i, t]) => `ảnh gửi thứ ${i + 1} = ảnh gửi thứ ${t.vt + 1}`).join('; ')}).` : '';\nreturn ks.filter((_, i) => !bo.has(i)).map(x => ({ json: { ...x, trungMsg } }));"
