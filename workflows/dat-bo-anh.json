    {
      "parameters": {
        "jsCode": "// Vuông đầu tiên = ảnh chính; ngang đầu tiên = ảnh bìa Zalo OA + album Fanpage (#fb để Zalo không lặp); còn lại = ảnh thêm\nconst k = $('Kiểm tra lệnh').first().json;\nconst sizes = $('Đo kích thước').all().map(i => i.json);\nconst links = $('Lấy link ảnh').all().map(i => ((i.json.images || []).sort((a, b) => b.width - a.width)[0] || {}).source || '');\nif (!links.length || links.some(x => !x)) throw new Error('Không lấy được link ảnh trên Fanpage');\nconst items = links.map((u, i) => { const w = sizes[i]?.w || 0, h = sizes[i]?.h || 0; return { u, w, h, ngang: !!(w && h && w / h >= 1.3) }; });\nconst main = items.find(x => !x.ngang) || items[0];\nconst bia = items.find(x => x.ngang) || null;\nconst them = items.filter(x => x !== main).map(x => (x === bia ? x.u + '#fb' : x.u));\nconst biaVal = bia ? bia.u + '#tay' : k.curBia;\nconst now = DateTime.now().setZone('Asia/Ho_Chi_Minh').toFormat('dd/MM/yyyy HH:mm');\nconst hist = [];\nif (k.curAnh && k.curAnh !== main.u) hist.push({ 'Loại': 'Ảnh', 'Bản cũ': k.curAnh });\nif (bia && k.curBia && k.curBia !== biaVal) hist.push({ 'Loại': 'Ảnh bìa', 'Bản cũ': k.curBia });\nif (k.curZalo) hist.push({ 'Loại': 'Ảnh Zalo', 'Bản cũ': k.curZalo });\nlet canhBao = '';\nif (bia) { const r = bia.w / bia.h; if (r < 1.6 || r > 1.95) canhBao += `\\n⚠️ Ảnh ngang ${bia.w}×${bia.h} không đúng 16:9 nên ảnh bìa Zalo OA có thể bị cắt mép.`; }\nelse if (/#src=/.test(k.curBia)) canhBao += `\\n⚠️ Không có ảnh NGANG nên chưa có ảnh bìa Zalo OA mới (bìa cũ làm từ ảnh bài cũ, /duyet sẽ chặn). Gửi 1 ảnh ngang kèm ghi chú /dunganh ${k.id} hoặc gõ /anhbia ${k.id}.`;\nelse if (!k.curBia) canhBao += `\\n⚠️ Chưa có ảnh bìa Zalo OA: gửi 1 ảnh ngang kèm ghi chú /dunganh ${k.id} hoặc gõ /anhbia ${k.id}.`;\nif (!items.some(x => !x.ngang) && items.length) canhBao += '\\nℹ️ Không có ảnh vuông nên ảnh ngang đầu tiên được dùng làm ảnh chính.';\ncanhBao += $('Bỏ ảnh trùng').first().json.trungMsg || '';\nif (k.boQua) canhBao += `\\n⚠️ Bỏ qua ${k.boQua} ảnh vì Facebook chỉ cho tối đa 10 ảnh/bài.`;\nconst viTri = (x) => x === bia ? 'ngang – đầu album Fanpage, ảnh bìa Zalo OA' : x === main ? 'ảnh chính' : (x.ngang ? 'ngang' : 'vuông');\nconst ds = [main, ...items.filter(x => x !== main)].map((x, i) => ({ n: i + 1, mo: viTri(x), kenh: x === bia && x !== main ? 'fb' : '' }));\nconst note = [k.note0, `Đặt bộ ${items.length} ảnh qua Zalo ${now} (/datanh)`].filter(Boolean).join(' | ');\nreturn [{ json: { id: k.id, main: main.u, them, bia: biaVal, hist, canhBao, ds, note, soAnh: items.length,\n  update: { 'ID': k.id, 'Link ảnh': main.u, 'Ảnh thêm': them.join('\\n'), 'Ảnh bìa OA': biaVal, 'Ảnh Zalo': '', 'Ghi chú': note } } }];"
      },
