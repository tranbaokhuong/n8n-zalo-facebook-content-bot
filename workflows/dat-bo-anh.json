        "jsCode": "const x = $('Xếp bộ ảnh').first().json;\nlet att = null; try { att = $input.first().json.attachment_id || null; } catch (e) {}\nconst list = x.ds.map(d => `Ảnh ${d.n}: ${d.mo}`).join('\\n');\nconst text = `🖼️ BÀI #${x.id}: ĐÃ ĐẶT BỘ ${x.soAnh} ẢNH (dùng chung Fanpage + Zalo)\\n${list}${x.canhBao}`\n  + (att ? '\\n(Số trên ảnh = số thứ tự ảnh. Lúc đăng, Fanpage tự đưa ảnh ngang lên đầu album.)' : '\\n⚠️ Chưa ghép được ảnh xem trước, xem ảnh ở Sheet.');\nconst msgs = [att ? { text, attachment: { type: 'template', payload: { template_type: 'media', elements: [{ media_type: 'image', attachment_id: att }] } } } : { text }];\nmsgs.push({ text: `✅ Ưng thì: /duyet ${x.id} [giờ]\\n🔁 Đặt lại cả bộ: gửi ảnh rồi /datanh ${x.id} · Chỉnh lẻ: /dunganh, /themanh, /xoaanh ${x.id}\\n↩️ Ảnh chính cũ: /hoantac ${x.id} anh · Bìa cũ: /hoantac ${x.id} bia\\n📍 Muốn ảnh nằm đúng chỗ trong bài Zalo OA: thêm dòng [ảnh 2] (số trên ảnh lưới) vào chỗ đó bằng /dungbai ${x.id}` });\nreturn msgs.map(message => ({ json: { message } }));"
      },
