    {
      "parameters": {
        "jsCode": "// Gộp số liệu Facebook thành 1 dòng cho mỗi chiến dịch\nconst preset = $('Cấu hình').first().json.preset;\nconst get = (n) => { try { return $(n).first().json.data || []; } catch (e) { return []; } };\nconst campaigns = get('Lấy chiến dịch');\nconst adsets = get('Lấy nhóm quảng cáo');\nconst insC = get('Số liệu chiến dịch');\nconst insA = get('Số liệu quảng cáo');\n\nconst zone = 'Asia/Ho_Chi_Minh';\nconst now = DateTime.now().setZone(zone);\nconst day = preset === 'yesterday' ? now.minus({ days: 1 }) : now;\nconst ngay = day.toFormat('dd/MM/yyyy');\nconst fmt = (n) => Math.round(Number(n) || 0).toLocaleString('vi-VN');\n\nfunction results(actions) {\n  const m = {};\n  (actions || []).forEach(a => { m[a.action_type] = Number(a.value) || 0; });\n  const msg = m['onsite_conversion.messaging_conversation_started_7d'] || 0;\n  const lead = m['lead'] !== undefined ? m['lead']\n    : (m['onsite_conversion.lead_grouped'] || 0) + (m['offsite_conversion.fb_pixel_lead'] || 0);\n  return { msg, lead, total: msg + lead };\n}\n\nfunction names(obj) {\n  const out = [];\n  Object.values(obj || {}).forEach(arr => Array.isArray(arr) && arr.forEach(x => x && x.name && out.push(x.name)));\n  return out;\n}\n\nfunction targetText(t) {\n  if (!t) return '';\n  const p = [];\n  if (t.age_min) p.push(`${t.age_min}-${t.age_max || 65}`);\n  if (t.genders && t.genders.length) p.push(t.genders.map(g => g == 1 ? 'Nam' : 'Nữ').join('/'));\n  const geo = t.geo_locations || {};\n  const locs = [...(geo.countries || []), ...(geo.regions || []).map(r => r.name), ...(geo.cities || []).map(c => c.name)];\n  if (locs.length) p.push('Vị trí: ' + locs.join(', '));\n  (t.flexible_spec || []).forEach((g, i) => { const n = names(g); if (n.length) p.push(`Group ${i + 1}: ` + n.join(', ')); });\n  const ex = names(t.exclusions);\n  if (ex.length) p.push('Loại trừ: ' + ex.join(', '));\n  if (t.custom_audiences && t.custom_audiences.length) p.push('Tệp: ' + t.custom_audiences.map(a => a.name).join(', '));\n  if (t.excluded_custom_audiences && t.excluded_custom_audiences.length) p.push('Loại trừ tệp: ' + t.excluded_custom_audiences.map(a => a.name).join(', '));\n  if (t.targeting_automation && t.targeting_automation.advantage_audience) p.push('Advantage+');\n  return p.join(' | ');\n}\n\nconst insByC = {}; insC.forEach(r => { insByC[r.campaign_id] = r; });\nconst rows = [];\nfor (const c of campaigns) {\n  const ins = insByC[c.id];\n  if (c.effective_status !== 'ACTIVE' && !ins) continue;\n  const cAdsets = adsets.filter(a => a.campaign_id === c.id && (a.effective_status === 'ACTIVE' || insA.some(x => x.adset_id === a.id)));\n  const cAds = insA.filter(x => x.campaign_id === c.id);\n  const budget = c.daily_budget ? Number(c.daily_budget)\n    : cAdsets.reduce((s, a) => s + (Number(a.daily_budget) || 0), 0);\n  const r = results(ins && ins.actions);\n  const spend = Number(ins && ins.spend) || 0;\n  rows.push({\n    'Khóa': `${ngay}|${c.id}`,\n    'Ngày': ngay,\n    'Chiến dịch': c.name,\n    'Trạng thái': c.effective_status,\n    'Ngân sách/ngày': budget ? fmt(budget) : '',\n    'Chi tiêu': fmt(spend),\n    'Hiển thị': Number(ins && ins.impressions) || 0,\n    'Click': Number(ins && ins.clicks) || 0,\n    'Tin nhắn': r.msg,\n    'Lead': r.lead,\n    'Tổng kết quả': r.total,\n    'Chi phí/kết quả': r.total ? fmt(spend / r.total) : '',\n    'Số nhóm QC': cAdsets.length,\n    'Số QC': new Set(cAds.map(x => x.ad_id)).size,\n    'Chi tiết QC': cAds.map(x => {\n      const k = results(x.actions);\n      return `${x.adset_name} > ${x.ad_name}: imp=${x.impressions || 0}, click=${x.clicks || 0}, spend=${Math.round(Number(x.spend) || 0)}, conversion=${k.total}`;\n    }).join('\\n'),\n    'Target': cAdsets.map(a => `${a.name}: ${targetText(a.targeting)}`).join('\\n'),\n    'Cập nhật lúc': now.toFormat('dd/MM/yyyy HH:mm'),\n  });\n}\nif (!rows.length) rows.push({ 'Khóa': `${ngay}|none`, 'Ngày': ngay, 'Chiến dịch': 'Không có chiến dịch nào chạy', 'Cập nhật lúc': now.toFormat('dd/MM/yyyy HH:mm') });\nreturn rows.map(json => ({ json }));"
      },
