        "jsCode": "// Xác nhận vào nhóm, kèm ảnh vừa dùng\nconst p = $('Phân loại').first().json;\nlet att = null; try { att = $input.first().json.data?.attachment_id || null; } catch (e) {}\nconst text = p.kind === 'zalo'\n  ? `🖼️ BÀI #${p.id}: ĐÃ DÙNG ẢNH BẠN GỬI LÀM ẢNH BÀI RIÊNG CHO ZALO (OA + nhóm)\\n📘 Fanpage giữ ảnh cũ.\\n🔁 Muốn Fanpage và Zalo dùng chung 1 ảnh: gửi ảnh rồi gõ /dunganh ${p.id}`\n  : p.kind === 'anh' && p.kenh === 'fb'\n  ? `🖼️ BÀI #${p.id}: ĐÃ DÙNG ẢNH BẠN GỬI LÀM ẢNH BÀI RIÊNG CHO FANPAGE\\n💬 Zalo (OA + nhóm) giữ ảnh cũ.\\n↩️ Quay lại ảnh trước: /hoantac ${p.id} anh`\n  : p.kind === 'bia'\n  ? `🖼 BÀI #${p.id}: ĐÃ DÙNG ẢNH BẠN GỬI LÀM ẢNH BÌA ZALO OA${p.curAnh ? '' : ' VÀ ẢNH CHÍNH (bài chưa có ảnh chính)'}${p.canhBao}\\n↩️ Quay lại ảnh bìa trước: /hoantac ${p.id} bia\\n✅ Ưng cả bài lẫn ảnh bìa thì gõ: /duyet ${p.id}`\n  : `🖼️ BÀI #${p.id}: ĐÃ DÙNG ẢNH BẠN GỬI LÀM ẢNH BÀI CHUNG (Fanpage + Zalo)\\n🖌️ Ảnh bìa Zalo OA: gửi thêm 1 ảnh NGANG kèm ghi chú /dunganh ${p.id}, hoặc gõ /anhbia ${p.id} để AI làm từ ảnh này\\n↩️ Quay lại ảnh trước: /hoantac ${p.id} anh`;\nconst tm = $('Xử lý trùng').first().json.trungMsg || '';\nconst text2 = text.replace(/\\n/, tm + '\\n');\nreturn [{ json: { message: att ? { text: text2, attachment: { type: 'template', payload: { template_type: 'media', elements: [{ media_type: 'image', attachment_id: att }] } } } : { text: text2 } } }];"
      },
