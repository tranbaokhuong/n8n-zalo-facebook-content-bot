    {
      "parameters": {
        "jsCode": "// Ảnh chính trùng 1 ảnh thêm -> bỏ ảnh thêm đó; ảnh bìa trùng 1 ảnh thêm -> ảnh thêm đó chỉ còn ở album Fanpage (#fb), Zalo không lặp\nconst p = $('Phân loại').first().json;\nconst them = String(p.curThem || '').split('\\n').map(s => s.trim()).filter(Boolean);\nlet tr = []; try { tr = ($input.first().json.trung || []).filter(t => t.nhom === 'cu'); } catch (e) {}\nconst sach = (u) => String(u || '').trim().replace(/#(fb|zalo|tay|src=[a-z0-9]+)$/i, '');\nlet moi = them, trungMsg = '';\nif (tr.length && p.kind === 'anh' && p.kenh !== 'fb') {\n  const bo = new Set(tr.map(t => t.vt)); moi = them.filter((_, i) => !bo.has(i));\n  trungMsg = `\\n♻️ Ảnh này đang có trong ảnh thêm (ảnh ${[...bo].map(i => i + 2).join(', ')}) nên đã bỏ khỏi ảnh thêm để không đăng 2 lần.`;\n} else if (tr.length && p.kind === 'bia') {\n  const s = new Set(tr.map(t => t.vt)); moi = them.map((u, i) => s.has(i) ? sach(u) + '#fb' : u);\n  trungMsg = '\\n♻️ Ảnh ngang này cũng đang ở ảnh thêm: giữ trong album Fanpage, bài Zalo OA không chèn lặp.';\n}\nreturn [{ json: { them: moi.join('\\n'), trungMsg } }];"
      },
