        "jsCode": "// Bản JPEG đã lưu trên Fanpage (nhẹ, Zalo nhận được) để gửi xác nhận vào nhóm\nconst U = $('Link mới').first().json.url;\nconst buf = await this.helpers.httpRequest({ method: 'GET', url: U, encoding: 'arraybuffer', json: false });\nreturn [{ json: {}, binary: { data: await this.helpers.prepareBinaryData(Buffer.from(buf), 'anh.jpg', 'image/jpeg') } }];"
