    {
      "parameters": {
        "jsCode": "// Ảnh ngang (rộng/cao >= 1.3) -> ảnh bìa Zalo OA; còn lại (vuông/dọc) -> ảnh bài\nconst k = $('Kiểm tra lệnh').first().json;\nconst info = $input.first().json || {};\nconst w = Number(info.size?.width || info.width || 0), h = Number(info.size?.height || info.height || 0);\nconst r = w && h ? w / h : 1;\n// fb: luôn là ảnh bài Fanpage (kể cả ảnh ngang); zalo: ảnh vuông/dọc = ảnh bài riêng cho Zalo, ảnh ngang = ảnh bìa OA\nconst kind = k.kenh === 'fb' ? 'anh' : r >= 1.3 ? 'bia' : k.kenh === 'zalo' ? 'zalo' : 'anh';\nif (kind === 'anh' && k.st !== 'Chờ duyệt')\n  return [{ json: { ok: false, reply: `ℹ️ Bài #${k.id} đã duyệt (Chờ đăng) nên không đổi ảnh bài nữa. Ảnh ngang (ảnh bìa Zalo OA) thì vẫn đổi được.` } }];\nconst canhBao = kind === 'bia' && (r < 1.6 || r > 1.95) ? `\\n⚠️ Ảnh tỉ lệ ${w}×${h}, không đúng 16:9 nên Zalo có thể cắt bớt mép.` : '';\nconst now = DateTime.now().setZone('Asia/Ho_Chi_Minh').toFormat('dd/MM/yyyy HH:mm');\nconst note = [k.note0, `${kind === 'bia' ? 'Ảnh bìa OA' : kind === 'zalo' ? 'Ảnh bài riêng Zalo' : k.kenh === 'fb' ? 'Ảnh bài riêng Fanpage' : 'Ảnh bài'} tự thiết kế qua Zalo ${now}`].filter(Boolean).join(' | ');\nreturn [{ json: { ok: true, ...k, kind, w, h, canhBao, note } }];"
      },
