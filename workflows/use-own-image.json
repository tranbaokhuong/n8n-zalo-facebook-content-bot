      "parameters": {
        "jsCode": "// Kiểm tra bài + có ảnh chưa\nconst cmd = $('Khi được gọi').first().json;\nconst id = String(cmd.id);\nconst rows = $('Đọc lịch đăng').all().map(i => i.json);\nconst row = rows.find(r => String(r['ID']) === id);\nif (!row) return [{ json: { ok: false, reply: `❌ Không tìm thấy bài #${id} trong lịch đăng.` } }];\nif (!cmd.url) return [{ json: { ok: false, reply: `ℹ️ Chưa thấy ảnh nào để dùng cho bài #${id}.\\n📎 Gửi ảnh vào nhóm, phần ghi chú của ảnh gõ: /dunganh ${id}\\n(hoặc gửi ảnh trước rồi gõ /dunganh ${id} trong vòng 15 phút)` } }];\nconst st = String(row['Trạng thái'] || '').trim();\nif (!['Chờ duyệt', 'Chờ đăng'].includes(st)) return [{ json: { ok: false, reply: `ℹ️ Bài #${id} đang ở trạng thái \"${st || 'trống'}\" nên không đổi ảnh được.` } }];\nreturn [{ json: { ok: true, id, url: cmd.url, st, kenh: cmd.kenh || '', curZalo: String(row['Ảnh Zalo'] || '').trim(), curAnh: String(row['Link ảnh'] || '').trim(), curBia: String(row['Ảnh bìa OA'] || '').trim(), curThem: String(row['Ảnh thêm'] || '').trim(), note0: String(row['Ghi chú'] || '').trim() } }];"
      },
