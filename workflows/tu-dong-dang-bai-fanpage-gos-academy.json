      "parameters": {
        "jsCode": "// ===== CHẾ ĐỘ TEST =====\n// true  = tạo bài ẨN, KHÔNG hiện lên fanpage (để kiểm tra)\n// false = đăng công khai thật\nconst CHE_DO_TEST = false;\n// =======================\n\n// Chỉ giữ những bài đã đến giờ đăng (giờ Việt Nam).\n// Ô \"Thời gian đăng\" để trống = đăng ngay.\nconst zone = 'Asia/Ho_Chi_Minh';\nconst now = DateTime.now().setZone(zone);\nconst formats = [\n  'd/M/yyyy H:mm', 'd/M/yyyy H:mm:ss', 'd/M/yyyy',\n  'yyyy-MM-dd H:mm', 'yyyy-MM-dd H:mm:ss', 'yyyy-MM-dd'\n];\n\nfunction parseTime(v) {\n  if (v === undefined || v === null || String(v).trim() === '') return null;\n  const s = String(v).trim();\n  for (const f of formats) {\n    const d = DateTime.fromFormat(s, f, { zone });\n    if (d.isValid) return d;\n  }\n  return 'invalid';\n}\n\nconst FOOTER = \"---***---\\nCÔNG TY TNHH GOSTECH\\nGiải pháp phát triển doanh nghiệp\\n📍 Trụ sở chính: Số nhà 11, ngõ 245/116/27 Phố Định Công, Phường Định Công, Hà Nội\\n📍 Văn phòng: Tòa A3 Vinhomes Hàm Nghi, Phường Từ Liêm, Hà Nội\\n📞 Hotline: 0968 343 342\\n🌐 Website: gostech.vn | hocviendigital.vn\";\nconst withFooter = (s) => { s = String(s || '').trim(); return !s || s.includes('CÔNG TY TNHH GOSTECH') ? s : s + '\\n\\n' + FOOTER; };\n\nconst MK = /^\\[\\s*(?:ảnh|anh|hình|hinh)\\s*([0-9][0-9 ,+&và]*)\\]$/iu;   // dòng đánh dấu [ảnh 2] / [ảnh 2, 3]\nconst soMK = (l) => { const m = String(l || '').trim().match(MK); return m ? m[1].split(/[^0-9]+/).filter(Boolean).map(Number) : null; };\nconst boMK = (s) => String(s || '').split('\\n').filter(l => !soMK(l)).join('\\n').replace(/\\n{3,}/g, '\\n\\n');\nlet chi5Phut = false; try { chi5Phut = $('Mỗi 5 phút (bài hẹn giờ)').isExecuted; } catch (e) {}\nconst out = [];\n$input.all().forEach((item, index) => {\n  const r = item.json;\n  const noiDungGoc = withFooter(r['Nội dung']);   // còn dòng [ảnh N] cho Zalo OA\n  const noiDung = boMK(noiDungGoc);\n  const linkAnh = String(r['Link ảnh'] || '').trim();\n  if (!noiDung && !linkAnh) return;\n\n  const t = parseTime(r['Thời gian đăng']);\n  if (t === 'invalid') return; // sai định dạng ngày giờ -> bỏ qua\n  if (t && t > now) return;    // chưa đến giờ\n  if (chi5Phut && !t) return;   // lượt 5 phút chỉ đăng bài có hẹn giờ; bài không hẹn giờ đợi 19:30\n\n  out.push({\n    json: { ...r, noiDung, noiDungGoc, linkAnh, coAnh: linkAnh !== '', published: CHE_DO_TEST ? 'false' : 'true', cheDoTest: CHE_DO_TEST },\n    pairedItem: { item: index }\n  });\n});\n\n// Mỗi lần chỉ đăng 1 bài (bài đứng trước trong Sheet)\nreturn out.slice(0, 1);\n"
      },
