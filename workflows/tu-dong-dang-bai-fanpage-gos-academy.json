      "parameters": {
        "jsCode": "// Tin báo đã đăng bài\nconst r = $input.first().json;\nconst p = $('Lọc bài đến giờ').first().json;\n// Bài thật: workflow Đăng chéo gửi 1 tin tổng hợp (link Fanpage + Zalo OA + ảnh) nên ở đây không báo trùng\nif (!p.cheDoTest) return [];\nconst hook = String(p['Nội dung'] || '').split('\\n').find(l => l.trim()) || '';\nconst now = DateTime.now().setZone('Asia/Ho_Chi_Minh').toFormat('HH:mm dd/MM/yyyy');\nreturn [{ json: { text: `✅ ĐÃ ĐĂNG BÀI #${r.ID || p.ID} lên fanpage lúc ${now}\\n📝 ${hook.slice(0, 150)}\\n🔗 ${r['Link bài'] || ''}` } }];"
