    {
      "parameters": {
        "jsCode": "// Ảnh chính + ảnh thêm (tối đa 10) -> mỗi ảnh 1 item để tải ẩn lên Trang.\n// Ảnh NGANG xếp lên đầu (Facebook đặt ảnh đầu tiên to ở trên: kiểu 1 ngang + 2-3 vuông)\nconst p = $input.first().json;\n// ảnh thêm gắn #zalo chỉ dùng cho Zalo -> bỏ; #fb chỉ dùng cho Fanpage -> giữ (bỏ nhãn)\nconst all = [p.linkAnh, ...String(p['Ảnh thêm'] || '').split('\\n').map(s => s.trim()).filter(s => s && !/#zalo$/i.test(s)).map(s => s.replace(/#fb$/i, ''))].filter(Boolean).slice(0, 10);\nfunction size(b) {\n  if (b[0] === 0x89 && b[1] === 0x50) return { width: b.readUInt32BE(16), height: b.readUInt32BE(20) };            // PNG\n  if (b.toString('ascii', 0, 3) === 'GIF') return { width: b.readUInt16LE(6), height: b.readUInt16LE(8) };          // GIF\n  if (b.toString('ascii', 0, 4) === 'RIFF' && b.toString('ascii', 8, 12) === 'WEBP') {                             // WebP\n    const t = b.toString('ascii', 12, 16);\n    if (t === 'VP8X') return { width: 1 + b.readUIntLE(24, 3), height: 1 + b.readUIntLE(27, 3) };\n    if (t === 'VP8 ') return { width: b.readUInt16LE(26) & 0x3fff, height: b.readUInt16LE(28) & 0x3fff };\n    if (t === 'VP8L') { const n = b.readUInt32LE(21); return { width: (n & 0x3fff) + 1, height: ((n >> 14) & 0x3fff) + 1 }; }\n  }\n  if (b[0] === 0xff && b[1] === 0xd8) {                                                                              // JPEG: tìm khung SOF\n    let i = 2;\n    while (i < b.length - 9) {\n      if (b[i] !== 0xff) { i++; continue; }\n      const m = b[i + 1];\n      if (m >= 0xc0 && m <= 0xcf && ![0xc4, 0xc8, 0xcc].includes(m)) return { width: b.readUInt16BE(i + 7), height: b.readUInt16BE(i + 5) };\n      if (m === 0xd8 || m === 0x01 || (m >= 0xd0 && m <= 0xd7)) { i += 2; continue; }\n      i += 2 + b.readUInt16BE(i + 2);\n    }\n  }\n  return null;\n}\nconst items = [];\nfor (const [i, url] of all.entries()) {\n  let r = 1;\n  try { const b = Buffer.from(await this.helpers.httpRequest({ method: 'GET', url, encoding: 'arraybuffer', json: false })); const s = size(b); if (s && s.height) r = s.width / s.height; } catch (e) {}\n  items.push({ url, i, ngang: r >= 1.3 });\n}\nitems.sort((a, b) => (b.ngang - a.ngang) || (a.i - b.i));\nreturn items.map(x => ({ json: { url: x.url, ngang: x.ngang } }));"
      },
