    {
      "parameters": {
        "jsCode": "// 17:00: nhắc các bài còn Chờ duyệt. 19:00: báo bài sẽ đăng lúc 19:30 (cùng cách chọn với node Lọc bài đến giờ: bài Chờ đăng đứng trên cùng, đã đến giờ)\nlet is19 = false;\ntry { is19 = $('Nhắc 19h').isExecuted; } catch (e) {}\nconst rows = $input.all().map(i => i.json);\nconst zone = 'Asia/Ho_Chi_Minh';\nconst now = DateTime.now().setZone(zone);\nconst gioDang = now.set({ hour: 19, minute: 30, second: 0, millisecond: 0 });\nconst formats = ['d/M/yyyy H:mm', 'd/M/yyyy H:mm:ss', 'd/M/yyyy', 'yyyy-MM-dd H:mm', 'yyyy-MM-dd H:mm:ss', 'yyyy-MM-dd'];\nfunction parseTime(v) {\n  if (v === undefined || v === null || String(v).trim() === '') return null;\n  for (const f of formats) { const d = DateTime.fromFormat(String(v).trim(), f, { zone }); if (d.isValid) return d; }\n  return 'invalid';\n}\nconst st = (r) => String(r['Trạng thái'] || '').trim();\nconst ten = (r) => (String(r['Tiêu đề'] || '').trim() || String(r['Nội dung'] || '').split('\\n').find(l => l.trim()) || '').slice(0, 110);\nconst choDang = rows.filter(r => {\n  if (st(r) !== 'Chờ đăng') return false;\n  if (!String(r['Nội dung'] || '').trim() && !String(r['Link ảnh'] || '').trim()) return false;\n  const t = parseTime(r['Thời gian đăng']);\n  return t !== 'invalid' && (!t || t <= gioDang);\n});\nconst choDuyet = rows.filter(r => st(r) === 'Chờ duyệt');\nconst dsDuyet = choDuyet.slice(0, 10).map(r => `• #${r['ID']}: ${ten(r)}`).join('\\n');\nconst next = choDang[0];\nlet text = '';\nif (is19) {\n  if (next) {\n    text = `🔔 19:30 tối nay sẽ đăng bài #${next['ID']} lên Fanpage:\\n${ten(next)}\\n❌ Không muốn đăng thì gõ \"/bo ${next['ID']}\" trước 19:30.`\n      + (choDang.length > 1 ? `\\n(Còn ${choDang.length - 1} bài Chờ đăng, mỗi tối đăng 1 bài theo thứ tự.)` : '');\n  } else if (choDuyet.length) {\n    text = `ℹ️ Tối nay chưa có bài nào được duyệt nên 19:30 sẽ KHÔNG đăng bài.\\nĐang có ${choDuyet.length} bài chờ duyệt:\\n${dsDuyet}\\n👉 Gõ \"/duyet <số>\" trước 19:30 để đăng tối nay.`;\n  }\n} else if (choDuyet.length) {\n  text = `⏰ Còn ${choDuyet.length} bài chờ duyệt:\\n${dsDuyet}\\n👉 Gõ \"/duyet <số>\" trước 19:30 để đăng tối nay, hoặc \"/sua <số> <yêu cầu>\" nếu cần sửa.`\n    + (next ? `\\n(Đã có bài #${next['ID']} chờ đăng lúc 19:30.)` : '');\n}\nif (!text) return [];\nreturn [{ json: { text } }];\n"
      },
